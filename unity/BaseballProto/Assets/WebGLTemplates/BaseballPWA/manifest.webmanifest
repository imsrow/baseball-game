{
    "name": {{{ JSON.stringify(PRODUCT_NAME) }}},
    "short_name": {{{ JSON.stringify(PRODUCT_NAME) }}},
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#000000",
    "theme_color": "#000000",
    "description": {{{ JSON.stringify(PRODUCT_DESCRIPTION) }}},
    "icons": [
      { "src": "TemplateData/icons/icon-180.png", "sizes": "180x180", "type": "image/png" },
      { "src": "TemplateData/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
    ]
  }
