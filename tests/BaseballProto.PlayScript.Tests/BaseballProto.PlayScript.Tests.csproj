<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity 인플레이 연출 대본(PlayScriptBuilder 등)을 Unity 밖에서 검사한다.
    Unity 스크립트 파일을 그대로 컴파일하고, 쓰는 UnityEngine 타입만 UnityEngineStub.cs로 흉내 낸다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BaseballProto.PlayScript.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BaseballSim.Engine\BaseballSim.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\MotionEase.cs" Link="Unity\MotionEase.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\MotionSegment.cs" Link="Unity\MotionSegment.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\MotionTrack.cs" Link="Unity\MotionTrack.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\BallCamProfile.cs" Link="Unity\BallCamProfile.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\RunnerScript.cs" Link="Unity\RunnerScript.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\ThrowScript.cs" Link="Unity\ThrowScript.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\PlayScript.cs" Link="Unity\PlayScript.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\RunnerPlan.cs" Link="Unity\RunnerPlan.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\ThrowLeg.cs" Link="Unity\ThrowLeg.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\PlayScriptBuilder.cs" Link="Unity\PlayScriptBuilder.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\ProtoTuning.cs" Link="Unity\ProtoTuning.cs" />
    <Compile Include="..\..\unity\BaseballProto\Assets\Proto\Scripts\Core\MatchFactory.cs" Link="Unity\MatchFactory.cs" />
  </ItemGroup>

</Project>
